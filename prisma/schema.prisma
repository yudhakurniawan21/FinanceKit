generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

// Prisma 7: connection URL dikelola di prisma.config.ts (env DATABASE_URL).
datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────────────────────
// BetterAuth canonical models — jangan dimodifikasi agar adapter
// (better-auth/adapters/prisma) kompatibel. Cek: @auth/prisma-adapter.
// ──────────────────────────────────────────────────────────────
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  @@unique([email])
  @@map("user")

  // Relasi aplikasi
  sessions    Session[]
  accounts    Account[]
  settings    UserSettings?
  wallets     Wallet[]
  transfers   Transfer[]
  recurringTransactions RecurringTransaction[]
  goals       Goal[]
  netWorthItems NetWorthItem[]
  netWorthSnapshots NetWorthSnapshot[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
  @@map("verification")
}

// ──────────────────────────────────────────────────────────────
// Skema aplikasi (FinansialKit)
// ──────────────────────────────────────────────────────────────
model UserSettings {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale      String   @default("id-ID")
  currency    String   @default("IDR")
  dateFormat  String   @default("dd/MM/yyyy")
  timeZone    String   @default("Asia/Jakarta")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("user_settings")
}

model Category {
  id            String        @id @default(cuid())
  name          String
  slug          String
  type          TransactionType
  icon          String?
  color         String?
  budget        Int?          // cents, monthly budget for this category
  sortOrder     Int           @default(100)
  userId        String
  transactions  Transaction[]
  recurring     RecurringTransaction[]
  @@unique([userId, slug])
  @@index([userId, type])
  @@map("category")
}

model Transaction {
  id          String           @id @default(cuid())
  date        DateTime         @db.Date
  description String?
  amount      Int              // minor unit (cents for USD, rupiah for IDR) — cek currencies.ts
  type        TransactionType
  method      PaymentMethod?
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id])
  accountId   String?
  account     Wallet?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  recurringId String?
  recurring   RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  userId      String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  @@index([userId, date, type])
  @@index([categoryId])
  @@index([accountId])
  @@unique([recurringId, date])
  @@map("transaction")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  BANK
  E_WALLET
  CARD
}

// ── Akun (rekening/dompet) aplikasi — jangan tertukar dengan model
// Account milik better-auth (tabel "account"). Saldo TIDAK disimpan:
// dihitung dinamis dari transaksi + transfer.
enum WalletType {
  CASH
  BANK
  E_WALLET
  CARD
}

model Wallet {
  id           String        @id @default(cuid())
  name         String
  type         WalletType
  icon         String?
  color        String?
  isDefault    Boolean       @default(false)
  sortOrder    Int           @default(100)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurringTransactions RecurringTransaction[]
  transfersFrom Transfer[]   @relation("TransferFrom")
  transfersTo   Transfer[]   @relation("TransferTo")
  @@index([userId])
  @@map("wallet")
}

// Transfer antar akun — tidak mengubah total kekayaan, hanya saldo per akun.
model Transfer {
  id            String   @id @default(cuid())
  fromAccountId String
  fromAccount   Wallet   @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccountId   String
  toAccount     Wallet   @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  amount        Int      // minor unit
  date          DateTime @db.Date
  description   String?
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  @@index([userId, date])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("transfer")
}

// ── Transaksi berulang ──────────────────────────────────
// Menghasilkan transaksi nyata saat jatuh tempo (lihat lib/db/recurring.ts).
enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model RecurringTransaction {
  id          String              @id @default(cuid())
  description String
  amount      Int                 // minor unit
  type        TransactionType
  frequency   RecurringFrequency
  method      PaymentMethod?
  categoryId  String?
  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  accountId   String?
  account     Wallet?             @relation(fields: [accountId], references: [id], onDelete: SetNull)
  startDate   DateTime            @db.Date
  nextRunDate DateTime            @db.Date
  lastRunDate DateTime?
  isActive    Boolean             @default(true)
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  transactions Transaction[]
  @@index([userId, isActive])
  @@map("recurring_transaction")
}

// ── Tujuan tabungan ─────────────────────────────────────
// Progres dilacak manual via setor/tarik (bukan otomatis dari transaksi).
model Goal {
  id            String    @id @default(cuid())
  name          String
  targetAmount  Int       // minor unit
  currentAmount Int       @default(0)
  deadline      DateTime? @db.Date
  color         String?
  icon          String?
  sortOrder     Int       @default(100)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@index([userId])
  @@map("goal")
}

// ── Aset & kewajiban net worth ─────────────────────────
// Nilai diisi manual (investasi, properti, kendaraan, pinjaman, utang, dsb.).
// Saldo dompet dihitung otomatis sebagai aset likuid (lihat lib/db/net-worth.ts).
enum NetWorthType {
  ASSET
  LIABILITY
}

model NetWorthItem {
  id        String       @id @default(cuid())
  name      String
  type      NetWorthType
  value     Int          // minor unit — nilai saat ini (manual)
  color     String?
  icon      String?
  sortOrder Int          @default(100)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  @@index([userId])
  @@map("net_worth_item")
}

// Snapshot harian net worth untuk grafik tren. Satu baris per user per tanggal.
model NetWorthSnapshot {
  id                String   @id @default(cuid())
  date              DateTime @db.Date
  totalAssets       Int      // minor unit
  totalLiabilities  Int      // minor unit
  netWorth          Int      // minor unit
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  @@unique([userId, date])
  @@index([userId, date])
  @@map("net_worth_snapshot")
}
